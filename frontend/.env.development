# Archivo específico para modo development
# Este archivo tiene mayor prioridad que .env
# Se carga automáticamente cuando NODE_ENV=development o --mode development

# Modo de la aplicación: 'local' (RxDB + IndexedDB + Firestore backup)
VITE_APP_MODE=local

# Configuración de Firebase (para sincronización/backup opcional en desarrollo)
VITE_FIREBASE_API_KEY=demo_api_key
VITE_FIREBASE_AUTH_DOMAIN=demo-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-project
VITE_FIREBASE_STORAGE_BUCKET=demo-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef123456

# Clave secreta para JWT (desarrollo)
VITE_JWT_SECRET=development_secret_key_local_mode

# URL de la API (legacy, para compatibilidad)
VITE_API_URL=http://localhost:3000

# Flags de desarrollo
VITE_DEBUG=true
VITE_LOG_LEVEL=debug
VITE_ENABLE_DEV_TOOLS=true
