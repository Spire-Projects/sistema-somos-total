# Modo de la aplicación: 'local' o 'deploy'
VITE_APP_MODE=local

# Configuración de Firebase (para modo deploy y sincronización)
VITE_FIREBASE_API_KEY=demo_api_key
VITE_FIREBASE_AUTH_DOMAIN=demo-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-project
VITE_FIREBASE_STORAGE_BUCKET=demo-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef123456

# Clave secreta para JWT (cambiar en producción)
VITE_JWT_SECRET=development_secret_key_change_in_production

# URL de la API (legacy, para compatibilidad)
VITE_API_URL=http://localhost:3000
