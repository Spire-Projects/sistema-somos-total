{
  "name": "monorepoapp",
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev:frontend": "cd frontend && npm run dev",
    "dev:electron": "cross-env NODE_ENV=development electron --inspect=5858 electron/main.cjs",
    "dev:electron:watch": "tsc -p electron/tsconfig.json --watch",
    "dev": "concurrently \"npm run dev:frontend\" \"wait-on http://localhost:5173 && npm run dev:electron\"",
    "build:frontend": "cd frontend && npm run build",
    "build:electron": "echo 'Electron ya está en JavaScript'",
    "build": "npm run build:frontend",
    "package": "npm run build && electron-builder",
    "package:win": "npm run build && electron-builder --win",
    "package:linux": "npm run build && electron-builder --linux",
    "package:mac": "npm run build && electron-builder --mac",
    "dist": "npm run package",
    "dist:win": "npm run package:win",
    "start": "electron .",
    "clean": "rm -rf dist-electron frontend/dist release",
    "install:all": "npm install && cd frontend && npm install",
    "postinstall": "electron-builder install-app-deps"
  },
  "keywords": [
    "electron",
    "react",
    "vite",
    "rxdb",
    "farmaapp",
    "farmacia",
    "pharmacy"
  ],
  "author": "FarmaApp Team",
  "license": "ISC",
  "description": "Sistema de gestión farmacéutica con Electron, React y RxDB",
  "dependencies": {
    "@tailwindcss/vite": "^4.1.10",
    "express": "^5.1.0",
    "tailwindcss": "^4.1.10",
    "vite": "^6.3.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.10.2",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^36.4.0",
    "electron-builder": "^24.13.1",
    "tsx": "^4.20.3",
    "typescript": "~5.8.3",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.farmaapp.monorepo",
    "productName": "Farmacia_La_Bonita",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/main.cjs",
      "electron/preload.cjs",
      "frontend/dist/**/*",
      "node_modules/**/*",
      "!node_modules/**/test/**/*",
      "!node_modules/**/*.md"
    ],
    "extraResources": [],
    "win": {
      "icon": "assets/icons/logoWin.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "requestedExecutionLevel": "asInvoker",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FarmaApp"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ],
      "category": "Office",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.business",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "publish": null
  }
}
